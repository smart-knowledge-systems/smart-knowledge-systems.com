{
  "name": "com.smart-knowledge-systems.www",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "bun run --bun eslint . --cache",
    "lint:fix": "bun run --bun eslint --fix .",
    "typecheck": "bun run --bun tsc --noEmit",
    "check": "bun run --bun eslint . --cache && tsc --noEmit",
    "format": "bun run --bun prettier --write \"**/*.{ts,tsx,js,jsx,md,mdx,css}\" --cache -l",
    "format:check": "bun run --bun prettier --check \"**/*.{ts,tsx,js,jsx,md,mdx,css}\" --cache",
    "sequoia:publish": "sequoia publish",
    "sequoia:inject": "sequoia inject --output .next",
    "build:full": "bun run sequoia:publish && bun run build && bun run sequoia:inject",
    "publish": "bash scripts/publish.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@axiomhq/js": "^1.6.1",
    "@axiomhq/logging": "^0.2.1",
    "@axiomhq/nextjs": "^0.2.1",
    "@axiomhq/react": "^0.2.1",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@preact/signals": "^2.9.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.38.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-pretty-code": "^0.14.3",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.8.3",
    "sequoia-cli": "^0.5.6",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vercel": "^53.2.0",
    "vitest": "^4.1.5"
  }
}
